    <!-- Script Interaktif -->
    <script>
        let cart = [];
        let selectedFruits = [];

        function toggleCart() {
            document.getElementById('cart-drawer').classList.toggle('hidden');
        }

        function addToCart(name, price, image) {
            const existing = cart.find(item => item.name === name);
            if(existing) {
                existing.qty += 1;
            } else {
                cart.push({ name, price, qty: 1, image });
            }
            updateCartUI();
        }

        function updateCartUI() {
            const container = document.getElementById('cart-items');
            const badge = document.getElementById('cart-badge');
            const totalEl = document.getElementById('cart-total');

            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            if(totalQty > 0) {
                badge.textContent = totalQty;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            if(cart.length === 0) {
                container.innerHTML = `<p class="text-center text-slate-400 py-12 text-sm">Keranjang belanjaan masih kosong.</p>`;
            } else {
                container.innerHTML = cart.map((item, index) => `
                    <div class="flex items-center gap-4 bg-slate-50 p-3 rounded-2xl border border-slate-100">
                        <img src="${item.image}" class="w-16 h-16 rounded-xl object-cover">
                        <div class="flex-1">
                            <h4 class="font-bold text-slate-900 text-sm">${item.name}</h4>
                            <p class="text-xs text-slate-500">Rp ${item.price.toLocaleString('id-ID')}</p>
                            <div class="flex items-center gap-3 mt-2">
                                <button onclick="changeQty(${index}, -1)" class="w-6 h-6 rounded-lg bg-white border border-slate-200 text-xs font-bold">-</button>
                                <span class="text-xs font-bold">${item.qty}</span>
                                <button onclick="changeQty(${index}, 1)" class="w-6 h-6 rounded-lg bg-white border border-slate-200 text-xs font-bold">+</button>
                            </div>
                        </div>
                    </div>
                `).join('');
            }

            totalEl.textContent = `Rp ${totalPrice.toLocaleString('id-ID')}`;
        }

        function changeQty(index, delta) {
            cart[index].qty += delta;
            if(cart[index].qty <= 0) cart.splice(index, 1);
            updateCartUI();
        }

        function toggleFruit(fruit) {
            const idx = selectedFruits.indexOf(fruit);
            if(idx > -1) {
                selectedFruits.splice(idx, 1);
            } else {
                if(selectedFruits.length < 3) {
                    selectedFruits.push(fruit);
                } else {
                    alert('Maksimal memilih 3 jenis buah.');
                }
            }

            document.querySelectorAll('.fruit-btn').forEach(btn => {
                const f = btn.getAttribute('data-fruit');
                if(selectedFruits.includes(f)) {
                    btn.classList.add('bg-brand-600', 'border-brand-500', 'text-white');
                    btn.classList.remove('bg-slate-800/80', 'border-slate-700');
                } else {
                    btn.classList.remove('bg-brand-600', 'border-brand-500', 'text-white');
                    btn.classList.add('bg-slate-800/80', 'border-slate-700');
                }
            });

            document.getElementById('custom-selected-list').textContent = selectedFruits.length ? selectedFruits.join(', ') : 'Belum memilih';
            document.getElementById('custom-calories').textContent = `${selectedFruits.length * 25} kcal`;
        }

        function addCustomToCart() {
            if(selectedFruits.length === 0) {
                alert('Silakan pilih minimal 1 jenis buah.');
                return;
            }
            addToCart(`Custom Cup (${selectedFruits.join(', ')})`, 8000, 'watermarked_img_5243016340651718435.jpg');
            toggleCart();
        }

        function checkoutWA() {
            if(cart.length === 0) return;
            let text = "Halo Frozeria, saya ingin memesan:\n\n";
            cart.forEach(item => {
                text += `• ${item.name} (${item.qty}x) = Rp ${(item.price * item.qty).toLocaleString('id-ID')}\n`;
            });
            const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            text += `\n*Total: Rp ${total.toLocaleString('id-ID')}*\nMohon diproses, terima kasih!`;
            
            window.open(`https://wa.me/6281553901849?text=${encodeURIComponent(text)}`, '_blank');
            
        }
    </script>
